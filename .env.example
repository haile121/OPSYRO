# Django development settings
DJANGO_SECRET_KEY=replace-with-a-local-development-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001

# PostgreSQL (development only)
POSTGRES_DB=opsyro
POSTGRES_USER=postgres.your-project-ref
POSTGRES_PASSWORD=your-database-password
POSTGRES_HOST=your-project.pooler.supabase.com
POSTGRES_PORT=5432
# Use require for remote PostgreSQL services such as Supabase; prefer is fine for local Docker Postgres.
POSTGRES_SSLMODE=prefer

# Optional local Redis; leave blank to use Channels in-memory development layer.
REDIS_URL=

# Browser API origin
NEXT_PUBLIC_API_URL=http://localhost:8000

# Set only after creating a Twitch Extension; never commit the real secret.
TWITCH_EXTENSION_SECRET=

# Twitch OAuth Authorization Code Grant; keep the client secret backend-only.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TWITCH_TOKEN_ENCRYPTION_KEY=
TWITCH_REDIRECT_URI=http://localhost:8000/api/v1/auth/twitch/callback
TWITCH_OAUTH_RETURN_URL=http://localhost:3000/workspace
