# Django development settings
DJANGO_SECRET_KEY=replace-with-a-local-development-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=opsyro
POSTGRES_USER=opsyro
POSTGRES_PASSWORD=opsyro
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Optional for local development. Without it, Channels uses its in-memory layer.
REDIS_URL=

# Frontend API origin
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
