# Django development settings
DJANGO_SECRET_KEY=replace-with-a-local-development-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001

# PostgreSQL (development only)
POSTGRES_DB=opsyro
POSTGRES_USER=opsyro
POSTGRES_PASSWORD=opsyro
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Optional local Redis; leave blank to use Channels in-memory development layer.
REDIS_URL=

# Browser API origin
NEXT_PUBLIC_API_URL=http://localhost:8000

# Set only after creating a Twitch Extension; never commit the real secret.
TWITCH_EXTENSION_SECRET=
